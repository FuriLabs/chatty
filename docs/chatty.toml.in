[library]
version = "@VERSION@"
description = "Chatty is a chat application for mobile devices targetting SMS/MMS/Matrix and XMPP"
authors = "The Chatty Developers"
license = "GPL-3-or-later"
browse_url = "https://gitlab.gnome.org/World/Chatty"
repository_url = "https://gitlab.gnome.org/World/Chatty.git"
dependencies = [
  "Gio-2.0",
  "GLib-2.0",
  "Gtk-4.0",
  "Adwaita-1.0",
]
devhelp = true
seach_index = true

[dependencies."Gio-2.0"]
name = "GIO"
description = "GObject Interfaces and Objects, Networking, IPC, and I/O"
docs_url = "https://docs.gtk.org/gio/"

[dependencies."GLib-2.0"]
name = "GLib"
description = "The base type system library"
docs_url = "https://docs.gtk.org/glib/"

[dependencies."Gtk-4.0"]
name = "GTK"
description = "The GTK toolkit"
docs_url = "https://docs.gtk.org/gtk4/"

[dependencies."Adwaita-1.0"]
name = "Adwaita"
description = "Building blocks for modern adaptive GNOME applications."
docs_url = "https://gnome.pages.gitlab.gnome.org/libadwaita/doc/1-latest/"

[theme]
name = "basic"
show_index_summary = true
show_class_hierarchy = true

[source-location]
# The base URL for the web UI
base_url = "https://gitlab.gnome.org/World/Chatty/blob/-/main/"
# The format for links, using "filename" and "line" for the format
file_format = "{filename}#L{line}"

[extra]
urlmap_file = "urlmap.js"
